{
    "cleanUrls": true,
    "rewrites": [
        {
            "source": "/assets/(.*)",
            "destination": "/assets/$1"
        },
        {
            "source": "/api/nfemail/(.*)",
            "destination": "https://api.nfemail.com.br/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}